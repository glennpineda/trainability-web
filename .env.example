# Copy to .env (never committed) or set these as environment variables
# in your Claude Code cloud environment settings.
FTP_HOST=ftp.example.com
FTP_USER=username
FTP_PASS=password
# Folder on the server the site is served from, e.g. /public_html
FTP_REMOTE_DIR=/public_html
# ftp, ftps (explicit TLS, recommended) or sftp
FTP_PROTOCOL=ftps
FTP_PORT=
